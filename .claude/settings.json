{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)"
    ],
    "ask": [
      "Bash(supabase db push *)",
      "Bash(supabase functions deploy *)",
      "Bash(supabase secrets set *)",
      "Bash(supabase migration up *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/writespec-guard\"",
            "timeout": 10,
            "statusMessage": "Checking writespec compliance..."
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/tools/spend-guard\"",
            "timeout": 10,
            "statusMessage": "Checking delegation spend ledger..."
          }
        ]
      }
    ]
  }
}
