#!/usr/bin/env python3
"""Create and coordinate isolated Codex/Claude task worktrees."""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone


EX_USAGE = 64
EX_STATE = 73
EX_DIRTY = 72
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
OWNER_RE = re.compile(r"^[A-Za-z0-9_./:@-]+$")
WRITER_ROLES = {"implementer", "mechanical-worker"}


def die(message: str, code: int = EX_STATE) -> "NoReturn":
    print(message, file=sys.stderr)
    raise SystemExit(code)


def git(*args: str, cwd: Path | None = None, check: bool = True) -> str:
    proc = subprocess.run(
        ["git", *args],
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if check and proc.returncode:
        die(proc.stderr.strip() or f"git {' '.join(args)} failed", proc.returncode)
    return proc.stdout.strip()


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def repository_paths() -> tuple[Path, Path, Path]:
    current_root = Path(git("rev-parse", "--show-toplevel")).resolve()
    common_git = Path(
        git("rev-parse", "--path-format=absolute", "--git-common-dir")
    ).resolve()
    main_root = common_git.parent
    state_dir = Path(
        os.environ.get(
            "AGENT_WORKTREE_STATE_DIR", str(main_root / ".worktrees" / ".state")
        )
    ).resolve()
    return current_root, main_root, state_dir


CURRENT_ROOT, MAIN_ROOT, STATE_DIR = repository_paths()


def usage() -> None:
    print(
        "Usage:\n"
        "  tools/agent-worktree <codex|claude> <task-slug>\n"
        "  tools/agent-worktree status [task-slug]\n"
        "  tools/agent-worktree claim <task-slug> <implementer|mechanical-worker|reviewer> <owner-id>\n"
        "  tools/agent-worktree release <task-slug> <IMPLEMENTATION_DONE|REVIEW_CLEAR|REVIEW_FAILED_1|REVIEW_FAILED_TWICE|ABANDONED> <owner-id>\n"
        "  tools/agent-worktree ready <task-slug> <reviewed-commit>\n"
        "  tools/agent-worktree integrate <task-slug> <integrated-commit>\n"
        "  tools/agent-worktree abandon <task-slug>\n"
        "  tools/agent-worktree cleanup <task-slug>",
        file=sys.stderr,
    )


def validate_slug(task: str) -> None:
    if not SLUG_RE.fullmatch(task):
        die("Task slug must use lowercase letters, digits, and hyphens.", EX_USAGE)


def validate_owner(owner_id: str) -> None:
    if not OWNER_RE.fullmatch(owner_id):
        die(
            "Owner id must use letters, digits, _, ., /, :, @, or -.",
            EX_USAGE,
        )


def state_path(task: str) -> Path:
    validate_slug(task)
    return STATE_DIR / f"{task}.json"


class StateLock:
    def __enter__(self) -> "StateLock":
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.handle = (STATE_DIR / ".lock").open("a+")
        fcntl.flock(self.handle.fileno(), fcntl.LOCK_EX)
        return self

    def __exit__(self, *_args: object) -> None:
        fcntl.flock(self.handle.fileno(), fcntl.LOCK_UN)
        self.handle.close()


def load_state(task: str) -> dict:
    path = state_path(task)
    if not path.exists():
        die(f"No lifecycle state for task: {task}")
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        die(f"Cannot read lifecycle state {path}: {exc}")


def save_state(task: str, state: dict) -> None:
    state["updated_at"] = utc_now()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(
        prefix=f".{task}.", suffix=".tmp", dir=STATE_DIR
    )
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, state_path(task))
    finally:
        if os.path.exists(tmp_name):
            os.unlink(tmp_name)


def emit(state: dict) -> None:
    print(json.dumps(state, indent=2, sort_keys=True))


def create(tool: str, task: str) -> None:
    if tool not in {"codex", "claude"}:
        die("Tool must be codex or claude.", EX_USAGE)
    validate_slug(task)

    relative_worktree = Path(".worktrees") / f"{tool}-{task}"
    worktree = MAIN_ROOT / relative_worktree
    branch = f"agent/{tool}/{task}"
    shared_setup = [
        ".gitignore",
        "AGENTS.md",
        "CLAUDE.md",
        "docs/agent_workflow.md",
        "docs/agent_roster.md",
        "docs/workflows",
        "docs/agent_setup",
        "tasks/route_state.md",
        ".agents",
        ".claude",
        ".codex",
        "tools/agent-lock",
        "tools/agent-worktree",
        "tools/test-project",
        "tools/check-agent-setup",
    ]

    with StateLock():
        if state_path(task).exists():
            die(f"Lifecycle state already exists for task: {task}")
        dirty = git("status", "--porcelain", "--", *shared_setup, cwd=MAIN_ROOT)
        if dirty:
            die(
                "Shared agent setup has uncommitted changes. Commit reviewed setup paths "
                "before creating worktrees.",
                EX_DIRTY,
            )
        if worktree.exists() or git("branch", "--list", branch, cwd=MAIN_ROOT):
            die(f"Worktree path or branch already exists: {relative_worktree} / {branch}")

        base_commit = git("rev-parse", "HEAD", cwd=MAIN_ROOT)
        target_branch = git("branch", "--show-current", cwd=MAIN_ROOT)
        git("worktree", "add", "-b", branch, str(worktree), "HEAD", cwd=MAIN_ROOT)
        state = {
            "task": task,
            "client": tool,
            "path": str(relative_worktree),
            "branch": branch,
            "target_branch": target_branch,
            "base_commit": base_commit,
            "state": "WORKTREE_CREATED",
            "owner_role": None,
            "owner_id": None,
            "attempt": 0,
            "created_at": utc_now(),
            "updated_at": utc_now(),
        }
        save_state(task, state)

    print(f"Created {relative_worktree} on {branch}")
    print("State: WORKTREE_CREATED; claim a write lease before editing.")


def status(task: str | None) -> None:
    with StateLock():
        if task:
            emit(load_state(task))
            return
        files = sorted(STATE_DIR.glob("*.json"))
        if not files:
            print("No agent worktree lifecycle records.")
            return
        emit({"tasks": [json.loads(path.read_text()) for path in files]})


def claim(task: str, role: str, owner_id: str) -> None:
    if role not in WRITER_ROLES | {"reviewer"}:
        die("Role must be implementer, mechanical-worker, or reviewer.", EX_USAGE)
    validate_owner(owner_id)
    with StateLock():
        state = load_state(task)
        if state.get("owner_role"):
            die(
                f"Task {task} is already owned by "
                f"{state['owner_role']} ({state['owner_id']})."
            )

        current = state["state"]
        if current == "WORKTREE_CREATED" and role in WRITER_ROLES:
            next_state, attempt = "IMPLEMENTING", 1
            state["original_writer_role"] = role
            state["original_writer_id"] = owner_id
        elif current == "IMPLEMENTATION_DONE" and role == "reviewer":
            next_state, attempt = "REVIEWING", state.get("attempt", 1)
        elif (
            current == "REVIEW_FAILED_1"
            and role == state.get("original_writer_role")
            and owner_id == state.get("original_writer_id")
        ):
            next_state, attempt = "REPAIRING", 2
        else:
            die(f"Cannot claim {task} as {role} from {current}.")

        state.update(
            {
                "state": next_state,
                "owner_role": role,
                "owner_id": owner_id,
                "attempt": attempt,
                "claimed_at": utc_now(),
            }
        )
        save_state(task, state)
        emit(state)


def release(task: str, outcome: str, owner_id: str) -> None:
    allowed_outcomes = {
        "IMPLEMENTATION_DONE",
        "REVIEW_CLEAR",
        "REVIEW_FAILED_1",
        "REVIEW_FAILED_TWICE",
        "ABANDONED",
    }
    if outcome not in allowed_outcomes:
        die(f"Unknown release outcome: {outcome}", EX_USAGE)
    validate_owner(owner_id)
    with StateLock():
        state = load_state(task)
        current = state["state"]
        role = state.get("owner_role")
        attempt = state.get("attempt", 1)
        if not role:
            die(f"Task {task} has no active write lease to release.")
        if owner_id != state.get("owner_id"):
            die(f"Owner id {owner_id} does not hold the write lease for {task}.")

        valid = outcome == "ABANDONED" and current in {
            "IMPLEMENTING",
            "REPAIRING",
            "REVIEWING",
        }
        if not valid and current in {"IMPLEMENTING", "REPAIRING"} and role in WRITER_ROLES:
            valid = outcome == "IMPLEMENTATION_DONE"
        elif not valid and current == "REVIEWING" and role == "reviewer":
            valid = outcome in (
                {"REVIEW_CLEAR", "REVIEW_FAILED_1"}
                if attempt == 1
                else {"REVIEW_CLEAR", "REVIEW_FAILED_TWICE"}
            )
        if not valid:
            die(
                f"Cannot release {task} from {current} as {outcome} "
                f"(attempt {attempt})."
            )

        reviewed_commit = None
        if outcome == "REVIEW_CLEAR":
            worktree = MAIN_ROOT / state["path"]
            dirty = git("status", "--porcelain", cwd=worktree)
            if dirty:
                die(
                    "REVIEW_CLEAR requires a clean worktree with reviewed changes committed.",
                    EX_DIRTY,
                )
            reviewed_commit = git("rev-parse", "HEAD", cwd=worktree)

        state.update(
            {
                "state": outcome,
                "owner_role": None,
                "owner_id": None,
                "released_at": utc_now(),
            }
        )
        if outcome == "ABANDONED":
            state["abandoned_at"] = utc_now()
        if reviewed_commit:
            state["reviewed_commit"] = reviewed_commit
        save_state(task, state)
        emit(state)


def verify_commit(commit: str) -> str:
    resolved = git(
        "rev-parse", "--verify", f"{commit}^{{commit}}", cwd=MAIN_ROOT, check=False
    )
    if not resolved:
        die(f"Commit does not exist in this repository: {commit}")
    return resolved


def is_ancestor(ancestor: str, descendant: str) -> bool:
    proc = subprocess.run(
        ["git", "merge-base", "--is-ancestor", ancestor, descendant],
        cwd=MAIN_ROOT,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return proc.returncode == 0


def integration_mode(state: dict, integrated: str) -> str:
    reviewed = state["reviewed_commit"]
    if is_ancestor(reviewed, integrated):
        return "ancestry"

    base = state["base_commit"]
    cherry = git("cherry", integrated, reviewed, base, cwd=MAIN_ROOT)
    lines = [line for line in cherry.splitlines() if line.strip()]
    if lines and all(line.startswith("- ") for line in lines):
        return "patch-equivalent-cherry-pick"
    die(
        f"Target tip {integrated} neither contains reviewed commit {reviewed} nor "
        "has a patch-equivalent cherry-pick of every reviewed change."
    )


def ready(task: str, commit: str) -> None:
    with StateLock():
        state = load_state(task)
        if state["state"] != "REVIEW_CLEAR" or state.get("owner_role"):
            die(f"Task {task} must be unowned and REVIEW_CLEAR before integration.")
        resolved = verify_commit(commit)
        reviewed = state.get("reviewed_commit")
        if reviewed and resolved != reviewed:
            die(f"Ready commit {resolved} differs from reviewer-cleared commit {reviewed}.")
        state.update({"state": "READY_TO_INTEGRATE", "reviewed_commit": resolved})
        save_state(task, state)
        emit(state)


def integrate(task: str, commit: str) -> None:
    with StateLock():
        state = load_state(task)
        if state["state"] != "READY_TO_INTEGRATE" or state.get("owner_role"):
            die(f"Task {task} must be unowned and READY_TO_INTEGRATE.")
        resolved = verify_commit(commit)
        target_ref = f"refs/heads/{state['target_branch']}"
        target_tip = git(
            "rev-parse", "--verify", target_ref, cwd=MAIN_ROOT, check=False
        )
        if not target_tip:
            die(f"Recorded target branch no longer exists: {state['target_branch']}")
        if resolved != target_tip:
            die(
                f"Integrated commit {resolved} is not the target branch tip {target_tip}."
            )
        mode = integration_mode(state, resolved)
        state.update(
            {
                "state": "INTEGRATED",
                "integrated_commit": resolved,
                "integration_mode": mode,
                "integrated_at": utc_now(),
            }
        )
        save_state(task, state)
        emit(state)


def abandon(task: str) -> None:
    with StateLock():
        state = load_state(task)
        if state.get("owner_role"):
            die(f"Release the active lease before abandoning {task}.")
        if state["state"] == "INTEGRATED":
            die(f"Integrated task {task} cannot be abandoned.")
        state.update({"state": "ABANDONED", "abandoned_at": utc_now()})
        save_state(task, state)
        emit(state)


def cleanup(task: str) -> None:
    with StateLock():
        state = load_state(task)
        if state.get("owner_role") or state["state"] not in {
            "INTEGRATED",
            "ABANDONED",
        }:
            die(f"Task {task} must be unowned and INTEGRATED or ABANDONED.")
        worktree = MAIN_ROOT / state["path"]
        removed = False
        if worktree.exists():
            dirty = git("status", "--porcelain", cwd=worktree)
            if dirty:
                die(f"Refusing cleanup: worktree is dirty: {worktree}", EX_DIRTY)
            git("worktree", "remove", str(worktree), cwd=MAIN_ROOT)
            removed = True
        branch_removed = False
        if state["state"] == "INTEGRATED" and git(
            "branch", "--list", state["branch"], cwd=MAIN_ROOT
        ):
            git("branch", "-d", state["branch"], cwd=MAIN_ROOT, check=False)
            branch_removed = not bool(
                git("branch", "--list", state["branch"], cwd=MAIN_ROOT)
            )
        state.update(
            {
                "cleaned_at": utc_now(),
                "worktree_removed": removed,
                "branch_removed": branch_removed,
            }
        )
        save_state(task, state)
        emit(state)


def main(argv: list[str]) -> None:
    if len(argv) == 2 and argv[0] in {"codex", "claude"}:
        create(argv[0], argv[1])
        return
    if not argv:
        usage()
        raise SystemExit(EX_USAGE)
    command, args = argv[0], argv[1:]
    arities = {
        "status": {0, 1},
        "claim": {3},
        "release": {3},
        "ready": {2},
        "integrate": {2},
        "abandon": {1},
        "cleanup": {1},
    }
    if command not in arities or len(args) not in arities[command]:
        usage()
        raise SystemExit(EX_USAGE)
    if command == "status":
        status(args[0] if args else None)
    elif command == "claim":
        claim(args[0], args[1], args[2])
    elif command == "release":
        release(args[0], args[1], args[2])
    elif command == "ready":
        ready(args[0], args[1])
    elif command == "integrate":
        integrate(args[0], args[1])
    elif command == "abandon":
        abandon(args[0])
    elif command == "cleanup":
        cleanup(args[0])


if __name__ == "__main__":
    main(sys.argv[1:])
