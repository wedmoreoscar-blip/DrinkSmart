#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: tools/agent-lock <scope> -- <command> [args...]" >&2
  echo "Scopes: dependencies, dev-server, supabase, benchmark, resource-heavy" >&2
}

if [[ $# -lt 3 || "$2" != "--" ]]; then
  usage
  exit 64
fi

scope="$1"
shift 2

case "$scope" in
  dependencies|dev-server|supabase|benchmark|resource-heavy) ;;
  *)
    echo "Unknown lock scope: $scope" >&2
    usage
    exit 64
    ;;
esac

lock_file="${TMPDIR:-/tmp}/drinksmart.${scope}.lock"
exec 9>"$lock_file"
if ! flock -n 9; then
  echo "Another job already holds $lock_file; wait for it to finish." >&2
  exit 75
fi

exec "$@"
