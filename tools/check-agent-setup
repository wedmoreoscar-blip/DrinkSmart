#!/usr/bin/env python3
"""Validate the portable Codex/Claude project setup without modifying it."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile
import tomllib


ROOT = Path(__file__).resolve().parents[1]
EXPECTED_SKILLS = {
    "audit-context",
    "bench",
    "codex-tui-relay",
    "decision-check",
    "handoff",
    "healthcheck",
    "kickoff",
    "make-bench",
    "relay-waker",
    "skill-writing",
    "speccheck",
    "teacher",
    "update-decisions",
    "writespec",
}
REQUIRED = {
    "AGENTS.md",
    "CLAUDE.md",
    ".codex/config.toml",
    ".claude/settings.json",
    "opencode.json",
    "docs/decisions.md",
    "docs/agent_setup/CODEX_TUI_MESSAGE_RELAY.md",
    "docs/agent_setup/CODEX_TUI_HUB_SETUP.md",
    "docs/agent_setup/CROSS_MACHINE_SETUP.md",
    "docs/agent_setup/RELAY_WAKER.md",
    "docs/workflows/agent_selection.md",
    "tasks/next_session_kickoff.md",
    "tools/agent-lock",
    "tools/codex-tui-relay-ledger",
    "tools/relay-hub-waker",
    "tools/traycer-identity",
    "tools/waker-daemon-start",
    "tools/test-project",
    "tools/writespec-guard",
    "tools/spend-guard",
    "docs/delegation_spend.md",
}
# Traycer serves the selection guide from this machine-global path; the repo copy is canonical.
TRAYCER_SELECTION_GUIDE = Path.home() / ".traycer/agent-selection-guide.md"


def fail(message: str, failures: list[str]) -> None:
    failures.append(message)
    print(f"FAIL {message}")


def parse_skill(path: Path, expected_name: str, failures: list[str]) -> None:
    text = path.read_text()
    match = re.match(r"^---\n(.*?)\n---\n", text, re.DOTALL)
    if not match:
        fail(f"{path.relative_to(ROOT)} has invalid frontmatter", failures)
        return
    fields: dict[str, str] = {}
    for line in match.group(1).splitlines():
        if ":" not in line:
            fail(f"{path.relative_to(ROOT)} has malformed frontmatter", failures)
            return
        key, value = line.split(":", 1)
        fields[key.strip()] = value.strip()
    if set(fields) != {"name", "description"}:
        fail(f"{path.relative_to(ROOT)} must contain only name and description", failures)
    if fields.get("name") != expected_name:
        fail(f"{path.relative_to(ROOT)} name does not match its directory", failures)
    if not fields.get("description"):
        fail(f"{path.relative_to(ROOT)} has an empty description", failures)


def check_relay_empty_content(failures: list[str]) -> None:
    helper = ROOT / "tools/codex-tui-relay-ledger"
    with tempfile.TemporaryDirectory(prefix="drinksmart-relay-check-") as directory:
        ledger = Path(directory) / "index.md"
        commands = (
            [str(helper), "init", "--ledger", str(ledger)],
            [
                str(helper), "append", "--ledger", str(ledger), "--type", "command.send",
                "--event-id", "01KZQ000000000000000000001", "--actor", "codex:test",
                "--ticket", "RELAY-TEST", "--target", "agent:test", "--content", "payload",
            ],
            [
                str(helper), "append", "--ledger", str(ledger), "--type", "command.claimed",
                "--event-id", "01KZQ000000000000000000002", "--actor", "hub:test",
                "--ticket", "RELAY-TEST", "--target", "agent:test",
                "--command", "01KZQ000000000000000000001",
            ],
            [str(helper), "validate", "--ledger", str(ledger)],
        )
        for command in commands:
            result = subprocess.run(command, capture_output=True, text=True, check=False)
            if result.returncode:
                detail = (result.stderr or result.stdout).strip()
                fail(f"relay ledger empty-content regression: {detail}", failures)
                return


def check_writespec_guard_detection(failures: list[str]) -> None:
    """The guard must govern real sends and ignore mere mentions of one.

    It once matched the phrase anywhere in the command, so a commit message or a
    grep discussing a send was denied as an uncommissioned delegation.
    """
    guard = ROOT / "tools/writespec-guard"
    cases = (
        ("git commit -F - <<'EOF'\nnote: traycer agent send routing\nEOF", False),
        ('grep -rn "traycer agent send" docs/', False),
        ('traycer agent send --to a --message "[no-spec] ping"', False),
        ('traycer agent send --to a --message "build the thing"', True),
        ('cd /tmp && traycer agent send --to a --message "build it"', True),
    )
    for command, should_deny in cases:
        result = subprocess.run(
            [str(guard)],
            input=json.dumps({"tool_name": "Bash", "tool_input": {"command": command}}),
            capture_output=True,
            text=True,
            check=False,
        )
        denied = "permissionDecision" in result.stdout
        if denied != should_deny:
            verb = "did not deny" if should_deny else "wrongly denied"
            fail(f"writespec-guard {verb}: {command!r}", failures)


def check_spend_guard_detection(failures: list[str]) -> None:
    """The guard must govern real merges of integration refs and nothing else.

    Hermetic: cases run against a temp git repo via SPEND_GUARD_REPO, so the
    result never depends on whether the real ledger happens to be dirty.
    """
    guard = ROOT / "tools/spend-guard"

    def run_case(command: str, repo: str, should_deny: bool) -> None:
        result = subprocess.run(
            [str(guard)],
            input=json.dumps({"tool_name": "Bash", "tool_input": {"command": command}}),
            capture_output=True,
            text=True,
            check=False,
            env={**os.environ, "SPEND_GUARD_REPO": repo},
        )
        denied = "permissionDecision" in result.stdout
        if denied != should_deny:
            verb = "did not deny" if should_deny else "wrongly denied"
            fail(f"spend-guard {verb}: {command!r}", failures)

    with tempfile.TemporaryDirectory(prefix="drinksmart-spend-check-") as directory:
        repo = Path(directory)
        ledger = repo / "docs/delegation_spend.md"
        ledger.parent.mkdir(parents=True)
        header = "# ledger\n\n| date | delegation | tokens | where |\n| --- | --- | --- | --- |\n"
        ledger.write_text(header)
        for cmd in (
            ["git", "init", "-q"],
            ["git", "-c", "user.email=t@t", "-c", "user.name=t", "add", "-A"],
            ["git", "-c", "user.email=t@t", "-c", "user.name=t", "commit", "-qm", "seed"],
        ):
            subprocess.run(cmd, cwd=repo, capture_output=True, check=True)

        merge = "git merge --ff-only integration/w4"
        # Mentions and non-integration merges pass through.
        run_case("git commit -F - <<'EOF'\nnote: git merge integration/w4 later\nEOF",
                 str(repo), False)
        run_case("git merge deepseek_agent_2", str(repo), False)
        run_case("git checkout integration/w4 && git merge deepseek_agent_2", str(repo), False)
        run_case(f"{merge}  # [no-ledger]", str(repo), False)
        # A real merge of an integration ref with a clean ledger is denied...
        run_case(merge, str(repo), True)
        # ...a malformed row does not satisfy it...
        ledger.write_text(header + "| soon | W4-5 | lots | stuff |\n")
        run_case(merge, str(repo), True)
        # ...and a well-formed uncommitted row allows it.
        ledger.write_text(header + "| 2026-08-13 | W4-5 keypad | ~38k | spec 6k, tests 22k |\n")
        run_case(merge, str(repo), False)


def main() -> int:
    failures: list[str] = []
    for relative in sorted(REQUIRED):
        if not (ROOT / relative).is_file():
            fail(f"missing {relative}", failures)

    if failures:
        return 1

    if not (ROOT / "CLAUDE.md").read_text().startswith("@AGENTS.md\n"):
        fail("CLAUDE.md does not import AGENTS.md first", failures)

    try:
        tomllib.loads((ROOT / ".codex/config.toml").read_text())
    except tomllib.TOMLDecodeError as exc:
        fail(f"invalid Codex TOML: {exc}", failures)

    try:
        json.loads((ROOT / ".claude/settings.json").read_text())
    except json.JSONDecodeError as exc:
        fail(f"invalid Claude settings JSON: {exc}", failures)

    try:
        opencode_cfg = json.loads((ROOT / "opencode.json").read_text())
    except json.JSONDecodeError as exc:
        fail(f"invalid opencode config JSON: {exc}", failures)
    opencode_paths = opencode_cfg.get("skills", {}).get("paths", [])
    if ".agents/skills" not in opencode_paths or ".claude/skills" not in opencode_paths:
        fail("opencode.json must register both .agents/skills and .claude/skills", failures)

    codex_root = ROOT / ".agents/skills"
    claude_root = ROOT / ".claude/skills"
    codex_names = {path.name for path in codex_root.iterdir() if path.is_dir()}
    claude_names = {path.name for path in claude_root.iterdir() if path.is_dir()}
    if codex_names != EXPECTED_SKILLS:
        fail(f"Codex skills differ: {sorted(codex_names ^ EXPECTED_SKILLS)}", failures)
    if claude_names != EXPECTED_SKILLS:
        fail(f"Claude skills differ: {sorted(claude_names ^ EXPECTED_SKILLS)}", failures)

    for name in sorted(EXPECTED_SKILLS):
        codex_skill = codex_root / name / "SKILL.md"
        claude_skill = claude_root / name / "SKILL.md"
        if not codex_skill.is_file() or not claude_skill.is_file():
            fail(f"missing mirrored SKILL.md for {name}", failures)
            continue
        parse_skill(codex_skill, name, failures)
        parse_skill(claude_skill, name, failures)
        if codex_skill.read_bytes() != claude_skill.read_bytes():
            fail(f"cross-client SKILL.md drift for {name}", failures)
        if not (codex_root / name / "agents/openai.yaml").is_file():
            fail(f"missing Codex UI metadata for {name}", failures)

    # A list, not a dict: several files carry more than one required marker.
    relay_checks = (
        ("AGENTS.md", "$codex-tui-relay"),
        ("docs/agent_setup/CODEX_TUI_MESSAGE_RELAY.md", "codex-tui-a2a-hub"),
        ("docs/agent_setup/CODEX_TUI_HUB_SETUP.md", "HUB_READY"),
        ("docs/workflows/delegation.md", "docs/agent_setup/CODEX_TUI_MESSAGE_RELAY.md"),
        ("docs/workflows/agent_selection.md", "$codex-tui-relay"),
        (".agents/skills/codex-tui-relay/SKILL.md",
         "docs/agent_setup/CODEX_TUI_MESSAGE_RELAY.md"),
        # The waker skill is deliberately thin; it must keep deferring to its doc.
        (".agents/skills/relay-waker/SKILL.md", "docs/agent_setup/RELAY_WAKER.md"),
        ("docs/agent_setup/RELAY_WAKER.md", "a2a-hub-waker"),
        # codex-tui-relay is the single entry point to the whole relay, so every part
        # must stay reachable from it. The daemon and its sender agent were once
        # undiscoverable from the skill, which is how they came to be missed.
        (".agents/skills/codex-tui-relay/SKILL.md", "docs/agent_setup/RELAY_WAKER.md"),
        (".agents/skills/codex-tui-relay/SKILL.md", "a2a-hub-waker"),
        (".agents/skills/codex-tui-relay/SKILL.md", "tools/waker-daemon-start"),
        ("docs/agent_setup/CODEX_TUI_MESSAGE_RELAY.md", "docs/agent_setup/RELAY_WAKER.md"),
        ("docs/agent_setup/CODEX_TUI_HUB_SETUP.md", "a2a-hub-waker"),
        ("docs/agent_setup/CROSS_MACHINE_SETUP.md", "RELAY_WAKER.md"),
    )
    for relative, marker in relay_checks:
        if marker not in (ROOT / relative).read_text():
            fail(f"{relative} is missing Codex TUI relay marker {marker!r}", failures)

    for relative in (
        "tools/agent-lock",
        "tools/codex-tui-relay-ledger",
        "tools/relay-hub-waker",
        "tools/traycer-identity",
        "tools/waker-daemon-start",
        "tools/test-project",
        "tools/writespec-guard",
        "tools/spend-guard",
    ):
        mode = (ROOT / relative).stat().st_mode
        if not mode & stat.S_IXUSR:
            fail(f"{relative} is not executable", failures)

    check_relay_empty_content(failures)
    check_writespec_guard_detection(failures)
    check_spend_guard_detection(failures)

    # The selection guide lives in two places. Absent is fine (fresh machine); divergent is not.
    canonical = (ROOT / "docs/workflows/agent_selection.md").read_bytes()
    if not TRAYCER_SELECTION_GUIDE.is_file():
        print(f"WARN selection guide not installed at {TRAYCER_SELECTION_GUIDE}; "
              f"copy docs/workflows/agent_selection.md there")
    elif TRAYCER_SELECTION_GUIDE.read_bytes() != canonical:
        fail(f"selection-guide drift: {TRAYCER_SELECTION_GUIDE} differs from "
             f"docs/workflows/agent_selection.md", failures)

    if failures:
        print(f"\n{len(failures)} agent-setup validation failure(s).")
        return 1
    print(f"PASS agent setup: {len(EXPECTED_SKILLS)} mirrored skills and required configs")
    return 0


if __name__ == "__main__":
    sys.exit(main())
