#!/usr/bin/env bash
set -uo pipefail

usage() {
  echo "Usage: tools/test-project <quick|build|full>" >&2
}

if [[ $# -ne 1 ]]; then
  usage
  exit 64
fi

run_check() {
  local label="$1"
  shift
  echo "RUN  $label"
  "$@"
  local command_status=$?
  if [[ $command_status -eq 0 ]]; then
    echo "PASS $label"
    return 0
  fi
  echo "FAIL $label (exit $command_status)" >&2
  return "$command_status"
}

profile="$1"
status=0

case "$profile" in
  quick)
    run_check typecheck npm run typecheck || status=1
    run_check lint npm run lint || status=1
    ;;
  build)
    run_check build npm run build || status=1
    ;;
  full)
    run_check typecheck npm run typecheck || status=1
    run_check lint npm run lint || status=1
    run_check build npm run build || status=1
    ;;
  *)
    usage
    exit 64
    ;;
esac

exit "$status"
