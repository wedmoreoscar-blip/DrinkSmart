#!/usr/bin/env python3
"""PreToolUse guard: no delegation is commissioned without a writespec spec.

Enforces the LOCKED "Traycer-orchestrated delegation" entry in docs/decisions.md.
Reads a Claude Code PreToolUse hook payload on stdin and denies any
`traycer agent send` that commissions work without the verbatim
writespec scope.md + closing.md blocks.

Replies (--response-id) are not commissions and pass through.

Messages carrying the literal marker [no-spec] also pass through. The sender
adds it deliberately to assert the message commissions no work: a status ping,
an acknowledgement, a stand-down. It is bypassable on purpose - this guard
exists to stop a spec being forgotten, not to defeat an adversary, and an
explicit assertion beats a heuristic that might misread a real commission as
chatter. Added 2026-08-08 after a status ping to a finished agent was denied.
"""
import json
import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BLOCKS = os.path.join(REPO, ".claude", "skills", "writespec", "blocks")

# Affirmative instructions to the implementer to produce its own test coverage.
# Verification belongs to the checker (docs/workflows/delegation.md): implementer
# tests duplicate the checker's work and, worse, encode the same blind spots, so a
# green suite can report success over a clause that was never built. Matched only
# after the verbatim scope.md/closing.md blocks are stripped, because closing.md
# legitimately contains "Do NOT write new tests".
TEST_COMMISSION_PATTERNS = [
    r"\brequires?\s+(?:new\s+|additional\s+|focused\s+)*(?:deterministic\s+)?tests?\b",
    r"\b(?:must|should|please)\s+(?:also\s+)?(?:write|add|create)\s+"
    r"(?:new\s+|additional\s+|focused\s+|deterministic\s+)*tests?\b",
    r"\b(?:write|add|create)\s+(?:new|additional|focused|deterministic)\s+"
    r"(?:\w+\s+)?tests?\b",
    r"\b(?:add|write)\s+(?:focused\s+)?vitest\s+(?:cases|tests)\b",
    r"\bexplicitly\s+requires?\s+.{0,40}tests?\b",
]


def allow():
    sys.exit(0)


def deny(reason):
    json.dump({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}, sys.stdout)
    sys.exit(0)


def norm(s):
    """Collapse whitespace so shell quoting and indentation don't cause false denials."""
    return re.sub(r"\s+", " ", s).strip()


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        allow()  # never break the session on a malformed payload

    if payload.get("tool_name") != "Bash":
        allow()

    cmd = payload.get("tool_input", {}).get("command", "")
    if "traycer agent send" not in cmd:
        allow()
    if "--response-id" in cmd:
        allow()  # a reply, not a commission
    if "[no-spec]" in cmd:
        allow()  # sender explicitly asserts this commissions no work

    try:
        with open(os.path.join(BLOCKS, "scope.md")) as f:
            scope = f.read()
        with open(os.path.join(BLOCKS, "closing.md")) as f:
            closing = f.read()
    except OSError as e:
        deny(f"writespec-guard cannot read the fixed blocks ({e}). "
             f"Expected them under {BLOCKS}.")

    # The spec is usually interpolated from a file rather than inlined, so search
    # the command text plus the contents of any file it reads.
    haystack = [cmd]
    for path in re.findall(r"(?:\$\(\s*cat\s+|\$\(\s*<\s*|\bcat\s+)([\"']?)([^\s\"';)]+)\1", cmd):
        candidate = path[1]
        if not os.path.isabs(candidate):
            candidate = os.path.join(os.getcwd(), candidate)
        try:
            with open(candidate) as f:
                haystack.append(f.read())
        except OSError:
            pass

    blob = norm("\n".join(haystack))
    missing = [name for name, block in (("scope.md", scope), ("closing.md", closing))
               if norm(block) not in blob]

    if missing:
        deny(
            "Blocked by writespec-guard: this `traycer agent send` commissions a "
            "delegation but the spec is missing the verbatim " + " and ".join(missing) +
            " block(s).\n\n"
            "docs/decisions.md (LOCKED - Traycer-orchestrated delegation) requires every "
            "delegation to be commissioned by a writespec spec, with the fixed blocks "
            "APPENDED, not retyped:\n\n"
            f"    cat {BLOCKS}/scope.md >> <spec-file>\n"
            f"    cat {BLOCKS}/closing.md >> <spec-file>\n\n"
            "Then re-send. If this is a reply rather than a commission, use --response-id."
        )

    # Verification is the checker's, not the implementer's.
    if "[implementer-tests]" not in cmd:
        body = blob
        for block in (scope, closing):
            body = body.replace(norm(block), " ")
        body = body.lower()
        hits = [p for p in TEST_COMMISSION_PATTERNS if re.search(p, body)]
        if hits:
            deny(
                "Blocked by writespec-guard: this spec appears to ask the implementer to "
                "write its own tests.\n\n"
                "docs/workflows/delegation.md puts verification on the checker, in one loop, on "
                "the integration branch. Implementer-written tests duplicate that work and "
                "encode the same blind spots, so a green suite can report success over a clause "
                "that was never built. This has happened twice here: W3-A1's fixtures hid a unit "
                "mismatch, and W3-A2 shipped a test named for the anchor clause that contained "
                "no anchor and passed against a function with no anchor parameter.\n\n"
                "Rewrite the spec so the implementer only confirms the code runs and the "
                "existing suite still passes, and derive coverage yourself under `speccheck`.\n\n"
                "If this ticket genuinely needs implementer-authored tests, state the reason in "
                "the spec and add the literal marker [implementer-tests] to the send command."
            )

    allow()


if __name__ == "__main__":
    main()
