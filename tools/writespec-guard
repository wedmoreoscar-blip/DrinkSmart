#!/usr/bin/env python3
"""PreToolUse guard: no delegation is commissioned without a writespec spec.

Enforces the LOCKED "Traycer-orchestrated delegation" entry in docs/decisions.md.
Reads a Claude Code PreToolUse hook payload on stdin and denies any
`traycer agent send` that commissions work without the verbatim
writespec scope.md + closing.md blocks.

Replies (--response-id) are not commissions and pass through.

Only an actual invocation is governed. The phrase appearing inside a heredoc,
a commit message, or a grep pattern is a mention, not a send. Fixed 2026-08-11
after this guard denied the commit that introduced the relay waker, because the
commit message discussed `traycer agent send`. `tools/check-agent-setup` holds
the regression cases.

Messages carrying the literal marker [no-spec] also pass through. The sender
adds it deliberately to assert the message commissions no work: a status ping,
an acknowledgement, a stand-down. It is bypassable on purpose - this guard
exists to stop a spec being forgotten, not to defeat an adversary, and an
explicit assertion beats a heuristic that might misread a real commission as
chatter. Added 2026-08-08 after a status ping to a finished agent was denied.
"""
import json
import os
import re
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BLOCKS = os.path.join(REPO, ".claude", "skills", "writespec", "blocks")

# Affirmative instructions to the implementer to produce its own test coverage.
# Verification belongs to the checker (docs/workflows/delegation.md): implementer
# tests duplicate the checker's work and, worse, encode the same blind spots, so a
# green suite can report success over a clause that was never built. Matched only
# after the verbatim scope.md/closing.md blocks are stripped, because closing.md
# legitimately contains "Do NOT write new tests".
# Imperatives aimed at the two commands the checker owns. Deliberately keyed on an
# instruction verb next to the command, so a spec may still QUOTE the baseline
# ("`npm run lint` -- KNOWN FAILING: 10 errors, 11 warnings") without tripping this.
HEAVY_COMMAND_PATTERNS = [
    # "Run these from the root of your worktree." introducing a list that contains one of
    # them AS AN ITEM. Keyed on shape rather than proximity: in the real 2026-08-12 spec
    # the imperative sat 451 chars from `npm run lint` and 744 from `npm run build`, so a
    # tight window missed the one case this rule exists for, while a window wide enough to
    # reach would match almost anything. Requiring a list marker is what keeps it precise --
    # a spec that merely QUOTES the counts never renders them as commands to run.
    r"\brun\s+(?:these|the\s+following|all\s+\w+|them)\b[\s\S]{0,1200}?[-*•]\s*`?npm run (?:lint|build)",
    r"\b(?:must|should|please|then)\s+run\s+`?npm run (?:lint|build)",
    r"\brun\s+`?npm run (?:lint|build)`?\s+(?:from|in|and|then|before|after)\b",
    r"^\s*[-*\d.]*\s*run\s+`?npm run (?:lint|build)",
]

TEST_COMMISSION_PATTERNS = [
    r"\brequires?\s+(?:new\s+|additional\s+|focused\s+)*(?:deterministic\s+)?tests?\b",
    r"\b(?:must|should|please)\s+(?:also\s+)?(?:write|add|create)\s+"
    r"(?:new\s+|additional\s+|focused\s+|deterministic\s+)*tests?\b",
    r"\b(?:write|add|create)\s+(?:new|additional|focused|deterministic)\s+"
    r"(?:\w+\s+)?tests?\b",
    r"\b(?:add|write)\s+(?:focused\s+)?vitest\s+(?:cases|tests)\b",
    r"\bexplicitly\s+requires?\s+.{0,40}tests?\b",
]


def allow():
    sys.exit(0)


def deny(reason):
    json.dump({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}, sys.stdout)
    sys.exit(0)


def norm(s):
    """Collapse whitespace so shell quoting and indentation don't cause false denials."""
    return re.sub(r"\s+", " ", s).strip()


# A heredoc body is data, not shell: a commit message or spec that merely discusses
# `traycer agent send` must not be read as issuing one. Stripping bodies before the
# invocation test fixes the false denial that blocked this guard's own commit.
HEREDOC_RE = re.compile(
    r"<<-?\s*(['\"]?)([A-Za-z_]\w*)\1.*?^\s*\2\s*$",
    re.DOTALL | re.MULTILINE,
)

# Wrappers and env assignments legitimately precede the real command.
_WRAPPER = (
    r"(?:\w+=\S*\s+|nohup\s+|setsid\s+|command\s+|time\s+|"
    r"env\s+(?:-[iu]\s+\S+\s+|\w+=\S*\s+)*)*"
)

# The phrase must sit at a command-start position to count as an invocation; a
# mention inside prose sits mid-sentence and is ignored. A bare quote is NOT a
# boundary, because `grep "traycer agent send" docs/` is a normal thing to do and
# denying it is worse than missing the contrived `bash -c` route. Only a quote
# introducing a nested shell counts.
INVOKE_RE = re.compile(
    r"""(?:\A|[;&|()\n]|\|\||&&|-l?c\s*["'])\s*""" + _WRAPPER
    + r"traycer\s+agent\s+send\b"
)


def commissions_a_send(cmd):
    """True when cmd actually invokes `traycer agent send`, not merely mentions it."""
    return bool(INVOKE_RE.search(HEREDOC_RE.sub(" ", cmd)))


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        allow()  # never break the session on a malformed payload

    if payload.get("tool_name") != "Bash":
        allow()

    cmd = payload.get("tool_input", {}).get("command", "")
    if not commissions_a_send(cmd):
        allow()
    if "--message" not in cmd:
        # `--message` is the only way `traycer agent send` carries a prompt, so a send
        # without one delivers nothing and commissions nothing. Chiefly this is
        # `traycer agent send --help`, which the guard denied on 2026-08-13 while the
        # orchestrator was merely reading the flag list - a denial with nothing to deny.
        # Keyed on the absence of a payload rather than on --help/-h, because a lone
        # `-h` is too easy to hit inside a real message body and would punch a hole in
        # the rule this guard exists to enforce.
        allow()
    if "--response-id" in cmd:
        allow()  # a reply, not a commission
    if "[no-spec]" in cmd:
        allow()  # sender explicitly asserts this commissions no work
    if "[visual-check]" in cmd:
        # docs/workflows/visual_check.md: the final visual pass is commissioned by a
        # rough brief, not a spec, because a spec would require first doing the very
        # discovery being delegated. Self-verification by screenshot is the mechanism
        # of that phase rather than a smell, so the test rule below is also waived.
        # Distinct from [no-spec], which asserts no work is commissioned at all.
        allow()

    try:
        with open(os.path.join(BLOCKS, "scope.md")) as f:
            scope = f.read()
        with open(os.path.join(BLOCKS, "closing.md")) as f:
            closing = f.read()
        with open(os.path.join(BLOCKS, "baseline.md")) as f:
            baseline = f.read()
    except OSError as e:
        deny(f"writespec-guard cannot read the fixed blocks ({e}). "
             f"Expected them under {BLOCKS}.")

    # The spec is usually interpolated from a file rather than inlined, so search
    # the command text plus the contents of any file it reads.
    haystack = [cmd]
    for path in re.findall(r"(?:\$\(\s*cat\s+|\$\(\s*<\s*|\bcat\s+)([\"']?)([^\s\"';)]+)\1", cmd):
        candidate = path[1]
        if not os.path.isabs(candidate):
            candidate = os.path.join(os.getcwd(), candidate)
        try:
            with open(candidate) as f:
                haystack.append(f.read())
        except OSError:
            pass

    blob = norm("\n".join(haystack))
    missing = [name for name, block in (("scope.md", scope), ("closing.md", closing),
                                        ("baseline.md", baseline))
               if norm(block) not in blob]

    if missing:
        deny(
            "Blocked by writespec-guard: this `traycer agent send` commissions a "
            "delegation but the spec is missing the verbatim " + " and ".join(missing) +
            " block(s).\n\n"
            "docs/decisions.md (LOCKED - Traycer-orchestrated delegation) requires every "
            "delegation to be commissioned by a writespec spec, with the fixed blocks "
            "APPENDED, not retyped:\n\n"
            f"    cat {BLOCKS}/scope.md >> <spec-file>\n"
            f"    cat {BLOCKS}/closing.md >> <spec-file>\n\n"
            "Then re-send. If this is a reply rather than a commission, use --response-id."
        )

    # The expensive half of the baseline is the checker's too.
    #
    # Same failure class as the test rule below, and it caught the orchestrator rather
    # than an implementer. On 2026-08-12 every Wave 4 spec appended closing.md -- which
    # asks only that the code runs and the existing suite passes -- and then added a
    # baseline section reading "Run these from the root of your worktree" above all four
    # commands. The blocks were present and verbatim, so the guard passed it; nothing
    # was checking whether the surrounding spec contradicted them.
    #
    # The cost was real: five agents on a 2-core box, load average 7.85-11.14, one
    # implementer's build at 2m40s against the orchestrator's 29s, and an agent that sat
    # twenty minutes on a tsc whose result was discarded and re-run on the integration
    # branch. A starved agent also looks exactly like a stalled one, which produced a
    # wrong diagnosis and a needless steer to five working agents.
    #
    # baseline.md now states the division of labour, so this only fires when a spec
    # instructs the expensive commands on top of it.
    body_nb = blob
    for block in (scope, closing, baseline):
        body_nb = body_nb.replace(norm(block), " ")
    heavy = [p for p in HEAVY_COMMAND_PATTERNS if re.search(p, body_nb.lower())]
    if heavy:
        deny(
            "Blocked by writespec-guard: this spec instructs the implementer to run "
            "`npm run lint` or `npm run build`.\n\n"
            "Those belong to the checker, which runs the full baseline once on the "
            "integration branch (docs/workflows/delegation.md step 13). They are the two "
            "most expensive commands here and the least informative to an implementer: "
            "lint is known-failing at a fixed count it cannot improve, and build reports "
            "nothing typecheck did not.\n\n"
            "State the literal counts so 'no worse' stays checkable, but let the appended "
            "baseline.md block say what to run. It already does.\n\n"
            f"    cat {BLOCKS}/baseline.md >> <spec-file>\n\n"
            "Quote the numbers; do not instruct the commands."
        )

    # Verification is the checker's, not the implementer's.
    if "[implementer-tests]" not in cmd:
        body = blob
        for block in (scope, closing, baseline):
            body = body.replace(norm(block), " ")
        body = body.lower()
        hits = [p for p in TEST_COMMISSION_PATTERNS if re.search(p, body)]
        if hits:
            deny(
                "Blocked by writespec-guard: this spec appears to ask the implementer to "
                "write its own tests.\n\n"
                "docs/workflows/delegation.md puts verification on the checker, in one loop, on "
                "the integration branch. Implementer-written tests duplicate that work and "
                "encode the same blind spots, so a green suite can report success over a clause "
                "that was never built. This has happened twice here: W3-A1's fixtures hid a unit "
                "mismatch, and W3-A2 shipped a test named for the anchor clause that contained "
                "no anchor and passed against a function with no anchor parameter.\n\n"
                "Rewrite the spec so the implementer only confirms the code runs and the "
                "existing suite still passes, and derive coverage yourself under `speccheck`.\n\n"
                "If this ticket genuinely needs implementer-authored tests, state the reason in "
                "the spec and add the literal marker [implementer-tests] to the send command."
            )

    allow()


if __name__ == "__main__":
    main()
