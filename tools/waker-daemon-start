#!/usr/bin/env bash
# Start, stop, and inspect the Codex TUI relay waker daemon.
#
# No agent ids appear anywhere in here on purpose. Traycer ids change whenever
# an agent is recreated; the daemon resolves the hub and sender by name at
# launch and again after any failed send, so a recreated agent heals itself
# without editing or restarting anything.
#
#   tools/waker-daemon-start            start it (detached, survives this shell)
#   tools/waker-daemon-start status     is it alive, and what did it last do
#   tools/waker-daemon-start stop       stop it
#   tools/waker-daemon-start restart    stop then start
#   tools/waker-daemon-start check      dry run: detect without waking the hub
#
# Override the defaults with RELAY_WAKER_HUB_NAME / RELAY_WAKER_SENDER_NAME.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WAKER="$ROOT/tools/relay-hub-waker"

EPIC_ID="${TRAYCER_EPIC_ID:-}"
HUB_NAME="${RELAY_WAKER_HUB_NAME:-codex-tui-a2a-hub}"
SENDER_NAME="${RELAY_WAKER_SENDER_NAME:-a2a-hub-waker}"

if [[ -z "$EPIC_ID" ]]; then
  echo "ERROR: TRAYCER_EPIC_ID is not set. Run this from a Traycer agent shell," >&2
  echo "       or export TRAYCER_EPIC_ID=<epic-id> first." >&2
  exit 2
fi

STATE_DIR="$HOME/.traycer/relay-waker"
LOG="$STATE_DIR/$EPIC_ID.log"
PIDFILE="$STATE_DIR/$EPIC_ID.pid"
mkdir -p "$STATE_DIR"

running_pid() {
  [[ -s "$PIDFILE" ]] || return 1
  local pid
  pid="$(tr -d '[:space:]' <"$PIDFILE")"
  [[ -n "$pid" ]] || return 1
  # A pidfile can outlive its process, and the pid can be recycled by something
  # unrelated, so confirm the process really is a waker before trusting it.
  if kill -0 "$pid" 2>/dev/null && tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q relay-hub-waker; then
    echo "$pid"
    return 0
  fi
  return 1
}

cmd_status() {
  local pid
  if pid="$(running_pid)"; then
    echo "RUNNING  pid $pid"
  else
    echo "STOPPED"
  fi
  echo "epic     $EPIC_ID"
  echo "hub      $HUB_NAME"
  echo "sender   $SENDER_NAME"
  echo "log      $LOG"
  if [[ -s "$LOG" ]]; then
    echo "--- last 5 log lines ---"
    tail -n 5 "$LOG"
  fi
}

cmd_stop() {
  local pid
  if pid="$(running_pid)"; then
    kill "$pid"
    for _ in $(seq 20); do
      running_pid >/dev/null || { echo "STOPPED  pid $pid"; return 0; }
      sleep 0.25
    done
    kill -9 "$pid" 2>/dev/null || true
    echo "KILLED   pid $pid"
  else
    echo "STOPPED  (was not running)"
  fi
}

cmd_check() {
  echo "Dry run — detects pending work, wakes nothing, spends nothing."
  "$WAKER" \
    --epic-id "$EPIC_ID" \
    --hub-name "$HUB_NAME" \
    --sender-name "$SENDER_NAME" \
    --once --dry-run
  echo "(no DRYRUN line above means nothing is pending, which is normal)"
}

cmd_start() {
  local pid
  if pid="$(running_pid)"; then
    echo "ALREADY RUNNING  pid $pid  (use restart to replace it)"
    return 0
  fi

  # Fail loudly here rather than in a background process nobody is watching.
  # --preflight only resolves the two agents: it never reads the ledger and can
  # never ping the hub, so a name typo cannot cost a turn.
  if ! "$WAKER" --epic-id "$EPIC_ID" --hub-name "$HUB_NAME" \
       --sender-name "$SENDER_NAME" --preflight >"$STATE_DIR/.preflight" 2>&1; then
    echo "ERROR: preflight failed — the daemon was not started." >&2
    sed 's/^/       /' "$STATE_DIR/.preflight" >&2
    echo "       Check that agents named '$HUB_NAME' and '$SENDER_NAME' exist." >&2
    rm -f "$STATE_DIR/.preflight"
    exit 1
  fi
  rm -f "$STATE_DIR/.preflight"

  # setsid detaches from this terminal; without it the daemon dies when the
  # shell closes, which is a confusing way to discover the relay went quiet.
  nohup setsid "$WAKER" \
    --epic-id "$EPIC_ID" \
    --hub-name "$HUB_NAME" \
    --sender-name "$SENDER_NAME" \
    --log "$LOG" \
    --pidfile "$PIDFILE" \
    >/dev/null 2>&1 &

  for _ in $(seq 20); do
    if pid="$(running_pid)"; then
      echo "STARTED  pid $pid"
      echo "log      $LOG"
      return 0
    fi
    sleep 0.25
  done

  echo "ERROR: daemon did not come up; last log lines:" >&2
  tail -n 10 "$LOG" >&2 2>/dev/null || true
  exit 1
}

case "${1:-start}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_stop; cmd_start ;;
  status)  cmd_status ;;
  check)   cmd_check ;;
  *)
    echo "usage: $(basename "$0") [start|stop|restart|status|check]" >&2
    exit 2
    ;;
esac
