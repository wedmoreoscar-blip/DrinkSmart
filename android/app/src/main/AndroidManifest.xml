<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        @capacitor/local-notifications merges POST_NOTIFICATIONS, WAKE_LOCK and
        RECEIVE_BOOT_COMPLETED in from its own manifest, so they are deliberately
        absent here. @capacitor/camera merges in only a <queries> intent and no
        permissions at all, so everything the scanner needs is declared below.

        NOT declared, and the decision is open rather than overlooked:
        SCHEDULE_EXACT_ALARM. On API 31+ the plugin falls back to an inexact
        alarm when it is missing, which is graceful but can drift a reminder by
        minutes — and minutes are the unit this app paces in. Adding it needs a
        Play Store justification, so it is Oscar's call, not a default.
    -->

    <!-- cameraService.ts uses CameraSource.Camera, which needs this outright. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        cameraService.ts also offers CameraSource.Photos. API 33+ reaches the
        library through the system photo picker and needs no permission, so the
        legacy read is capped at API 32 rather than requested from everyone.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>
