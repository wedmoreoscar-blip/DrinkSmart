# DrinkSmart — environment variables
# Copy this file to `.env` and fill in the values from your Supabase project.

# ─── Supabase (client-side) ────────────────────────────────────────────────
#
# Get these from your Supabase dashboard: Project Settings → API Keys.
#
# Use the MODERN publishable key (prefix: sb_publishable_...) — NOT the legacy
# JWT-format anon key. Both work today but the modern format is the recommended
# direction and supports key rotation without breaking active sessions.
#
# The publishable key is RLS-protected and safe to ship to the browser.

VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# ─── That's it. ───────────────────────────────────────────────────────────
#
# Server-side keys (SUPABASE_SECRET_KEY, SUPABASE_JWKS, etc.) are auto-
# provisioned by the Supabase platform on edge functions. You do not set them
# here.
#
# Function-specific API key (one Anthropic key powers both AI features:
# plan generation and menu scanning):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
